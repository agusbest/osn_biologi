APP_NAME="OSN Biology Academy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database. Lokal: MySQL (buat DB: CREATE DATABASE osn_academy CHARACTER SET utf8mb4;)
# --- Neon/produksi: DB_CONNECTION=pgsql, DB_PORT=5432, DB_SSLMODE=require (lihat DEPLOY.md)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=osn_academy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Email reset password: "log" menulis email ke storage/logs/laravel.log (aman untuk lokal).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@osn-academy.test"
MAIL_FROM_NAME="${APP_NAME}"
